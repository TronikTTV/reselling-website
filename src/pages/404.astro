---
import BaseLayout from '../layouts/BaseLayout.astro';
import Copy from '../components/Copy.astro';
import Icon from '../components/Icon.astro';
import { shopUrl, url } from '../lib/url';
---

<BaseLayout title="Page not found" noindex>
  <div class="container not-found">
    <p class="not-found__code gradient-text">404</p>
    <h1 class="page-head__title"><Copy name="notFound.title" accent /></h1>
    <p><Copy name="notFound.text" /></p>
    <div class="not-found__actions">
      <a class="button button--accent button--lg" href={shopUrl()}>
        <Copy name="notFound.shopButton" />
        <Icon name="arrow-right" />
      </a>
      <a class="button button--ghost button--lg" href={url('/')}><Copy name="notFound.homeButton" /></a>
    </div>
  </div>
</BaseLayout>

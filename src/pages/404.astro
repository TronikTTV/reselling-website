---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { shopUrl, url } from '../lib/url';
---

<BaseLayout title="Page not found" noindex>
  <div class="container not-found">
    <p class="not-found__code gradient-text">404</p>
    <h1 class="page-head__title">Gone <em>missing.</em></h1>
    <p>That page doesn't exist, or the piece has moved on. There's plenty more where it came from.</p>
    <div class="not-found__actions">
      <a class="button button--accent button--lg" href={shopUrl()}>
        Shop everything
        <Icon name="arrow-right" />
      </a>
      <a class="button button--ghost button--lg" href={url('/')}>Back home</a>
    </div>
  </div>
</BaseLayout>

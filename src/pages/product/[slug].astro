---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copy from '../../components/Copy.astro';
import Gallery from '../../components/Gallery.astro';
import Icon from '../../components/Icon.astro';
import ProductRail from '../../components/ProductRail.astro';
import ShareButton from '../../components/ShareButton.astro';
import { categoryOf, categoryTrail, getAllProducts, getListedProducts, type Product } from '../../lib/catalog';
import { isWithin } from '../../lib/category-tree';
import { contactLinks, type ContactLink } from '../../lib/contact';
import { copy } from '../../lib/copy';
import { authenticityLabel, formatPrice, STATUS_LABELS } from '../../lib/format';
import { sharePreview } from '../../lib/images';
import { normalise } from '../../lib/search';
import { categoryUrl, shopUrl, url } from '../../lib/url';

// Every product gets a page, sold ones included, so links people have shared keep working.
export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { title, brand, price, retailPrice, status, size, condition, tags, images, styleCode, colourway, includes, authenticity } =
  product.data;
const authenticityText = authenticityLabel(authenticity);
const { Content } = await render(product);
const hasDescription = Boolean(product.body?.trim());
const category = categoryOf(product);
// Trainers & Shoes › Nike › P-6000 (just the category when it has no sub-categories).
const trail = categoryTrail(category);
const priceText = formatPrice(price);
const showRetail = retailPrice !== undefined && price !== undefined && retailPrice > price;

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const contacts = status === 'sold' ? [] : contactLinks({ title, url: pageUrl });
const mainContact = contacts[0];
const preview = images[0] ? await sharePreview(images[0]) : undefined;
const description = [priceText, brand, size && `Size ${size}`, condition, styleCode, status !== 'available' && STATUS_LABELS[status]]
  .filter(Boolean)
  .join(' · ');

// data-edit hooks tell the admin Studio's live editor which part of the product was clicked.
const edit = (part?: string) => `product:${product.id}${part ? `:${part}` : ''}`;

const iconFor = (key: ContactLink['key']) =>
  key === 'instagram' ? 'instagram' : key === 'whatsapp' ? 'whatsapp' : key === 'email' ? 'mail' : 'arrow-up-right';

// "You might also like": the same (sub-)category first, then the rest of its top-level category, topped
// up with other pieces in stock.
const listed = (await getListedProducts()).filter((other) => other.id !== product.id && other.data.status !== 'sold');
const closeness = (other: Product) => {
  const slug = categoryOf(other).slug;
  return slug === category.slug ? 0 : isWithin(slug, trail[0].slug) ? 1 : 2;
};
const related = listed
  .map((other, index) => ({ other, index, rank: closeness(other) }))
  .sort((a, b) => a.rank - b.rank || a.index - b.index)
  .map(({ other }) => other)
  .slice(0, 10);

const specs = [
  size && { label: 'Size', value: size },
  condition && { label: 'Condition', value: condition },
  colourway && { label: 'Colourway', value: colourway },
  styleCode && { label: 'Style code', value: styleCode },
].filter((spec): spec is { label: string; value: string } => Boolean(spec));
---

<BaseLayout
  title={title}
  description={description || undefined}
  image={preview}
  currentCategory={category.slug}
  bodyClass={mainContact ? 'has-buy-bar' : undefined}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url('/')}>Home</a>
      {trail.map((item) => (
        <>
          <Icon name="chevron-right" size={14} />
          <a href={categoryUrl(item.slug)}>{item.name}</a>
        </>
      ))}
    </nav>

    <article class="product">
      <Gallery images={images} alt={title} edit={edit('images')} />

      <div class="product__info">
        <p class="product__brand" data-edit={edit('brand')}>{brand || category.name}</p>
        <h1 class="product__title" data-edit={edit('title')}>{title}</h1>

        <div class="product__price-row" data-edit={edit('price')}>
          <p class="product__price">
            <span data-field="price">{priceText ?? copy('common.askPrice')}</span>
            {showRetail && <s class="rrp">{`RRP ${formatPrice(retailPrice)}`}</s>}
          </p>
          <p class:list={['status', `status--${status}`]}>{STATUS_LABELS[status]}</p>
        </div>

        {
          authenticityText && (
            <p class="product__source" data-edit={edit('authenticity')}>
              <Icon name="bag" size={17} />
              <span>{authenticityText}</span>
            </p>
          )
        }

        <dl class="specs" data-edit={edit('details')}>
          {
            specs.map((spec) => (
              <div class="spec">
                <dt>{spec.label}</dt>
                <dd>{spec.value}</dd>
              </div>
            ))
          }
          {
            brand && (
              <div class="spec">
                <dt>Brand</dt>
                <dd>
                  <a href={shopUrl({ brand: normalise(brand) })}>{brand}</a>
                </dd>
              </div>
            )
          }
          <div class="spec">
            <dt>Category</dt>
            <dd>
              {trail.map((item, index) => (
                <>
                  {index > 0 && ' › '}
                  <a href={categoryUrl(item.slug)}>{item.name}</a>
                </>
              ))}
            </dd>
          </div>
          {
            includes.length > 0 && (
              <div class="spec spec--wide">
                <dt>What's included</dt>
                <dd>{includes.join(' · ')}</dd>
              </div>
            )
          }
        </dl>

        <div class="actions" data-main-cta>
          {
            status === 'sold' ? (
              <p class="notice">
                <Copy name="product.soldNotice" />
                {' '}
                <a href={categoryUrl(category.slug)}>{`See more in ${category.name}`}</a>
              </p>
            ) : (
              contacts.length > 0 && (
                <>
                  <p class="actions__label">
                    <Copy name={status === 'reserved' ? 'product.reservedLabel' : 'product.ctaLabel'} />
                  </p>
                  <div class="contact-buttons">
                    {contacts.map((contact, index) => (
                      <a
                        class:list={['button', 'button--block', index === 0 ? ['button--accent', 'button--lg'] : 'button--ghost']}
                        href={contact.href}
                        target={contact.external ? '_blank' : undefined}
                        rel={contact.external ? 'noopener' : undefined}
                      >
                        <Icon name={iconFor(contact.key)} />
                        {contact.key === 'instagram' ? <Copy name="product.instagramButton" /> : contact.label}
                      </a>
                    ))}
                  </div>
                </>
              )
            )
          }
          {status !== 'sold' && contacts.length === 0 && <p class="notice">Interested? Send this listing's link to ask about it.</p>}
          <ShareButton title={title} />
        </div>

        {
          hasDescription && (
            <div class="prose" data-edit={edit('body')}>
              <Content />
            </div>
          )
        }

        {
          tags.length > 0 && (
            <div class="tags" data-edit={edit('tags')}>
              {tags.map((tag) => (
                <a class="tag" href={shopUrl({ q: tag })}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </article>
  </div>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-title">
        <div class="container">
          <div class="section__head" data-reveal>
            <div>
              <p class="eyebrow">
                <Icon name="spark" size={14} />
                <Copy name="product.relatedEyebrow" />
              </p>
              <h2 class="section__title" id="related-title">
                <Copy name="product.relatedTitle" accent />
              </h2>
            </div>
            <a class="section__link" href={categoryUrl(category.slug)}>
              {`More ${category.name}`}
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        </div>
        <ProductRail products={related} label="You might also like" />
      </section>
    )
  }

  {
    mainContact && (
      <div class="buy-bar" data-buy-bar data-edit={edit()}>
        <div class="buy-bar__info">
          <p class="buy-bar__title" data-field="title">{title}</p>
          <p class="buy-bar__price" data-field="price">{priceText ?? copy('common.askPrice')}</p>
        </div>
        <a
          class="button button--accent"
          href={mainContact.href}
          target={mainContact.external ? '_blank' : undefined}
          rel={mainContact.external ? 'noopener' : undefined}
        >
          <Icon name={iconFor(mainContact.key)} size={18} />
          <Copy name="common.dmButton" />
        </a>
      </div>
    )
  }
</BaseLayout>

<script>
  // Phones: once the main "DM to cop" buttons have scrolled up out of view, a buy bar slides up.
  // (Checked on scroll rather than with an observer, so a fast fling past the buttons still counts.)
  const bar = document.querySelector<HTMLElement>('[data-buy-bar]');
  const mainCta = document.querySelector<HTMLElement>('[data-main-cta]');
  if (bar && mainCta) {
    let queued = false;
    const update = () => {
      bar.classList.toggle('is-visible', mainCta.getBoundingClientRect().bottom < 0);
      queued = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>

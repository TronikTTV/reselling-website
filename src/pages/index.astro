---
import AdReel, { type Ad } from '../components/AdReel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import Copy from '../components/Copy.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductRail from '../components/ProductRail.astro';
import { getCategorySummaries, getListedProducts } from '../lib/catalog';
import { primaryContact } from '../lib/contact';
import { productPhoto, sharePreview } from '../lib/images';
import { settings } from '../lib/site';
import { shopUrl, url } from '../lib/url';
import { productVideo } from '../lib/videos';

const products = await getListedProducts();
const inStock = products.filter((product) => product.data.status !== 'sold');
const withPhotos = inStock.filter((product) => product.data.images.length > 0);

// The ad reel: featured pieces (ones with a video first), topped up with the newest so it has at least 3.
const featured = withPhotos.filter((product) => product.data.featured);
const featuredFirst = [...featured.filter((product) => productVideo(product)), ...featured.filter((product) => !productVideo(product))];
const reelProducts = [...featuredFirst, ...withPhotos.filter((product) => !product.data.featured)].slice(0, Math.max(3, Math.min(featured.length, 6)));
const ads: Ad[] = await Promise.all(
  reelProducts.map(async (product) => ({
    product,
    photo: await productPhoto(product.data.images[0]),
    video: productVideo(product),
  })),
);

// The rest of the page shows what isn't already in the reel.
const reelIds = new Set(reelProducts.map((product) => product.id));
const notInReel = inStock.filter((product) => !reelIds.has(product.id));
const justDropped = notInReel.slice(0, 10);
const more = notInReel.slice(10, 18);
const summaries = (await getCategorySummaries()).filter((summary) => summary.count > 0);

const previewPhoto = reelProducts[0]?.data.images[0];
const preview = previewPhoto ? await sharePreview(previewPhoto) : undefined;

const dm = primaryContact();
const headingWords = settings.heroHeading.split(/\s+/).filter(Boolean);
const accentWords = settings.heroAccent.split(/\s+/).filter(Boolean);
---

<BaseLayout image={preview}>
  {
    ads.length > 0 && (
      <div class="reel-wrap">
        <AdReel ads={ads} dm={dm} />
      </div>
    )
  }

  <Marquee items={settings.ticker} />

  <section class="hero" data-hero data-reveal>
    <div class="container hero__inner">
      <p class="pill hero__pill">
        <span class="live-dot" aria-hidden="true"></span>
        {inStock.length > 0 ? `${inStock.length} ${inStock.length === 1 ? 'piece' : 'pieces'} live now` : <Copy name="home.comingSoon" />}
      </p>
      <h1 class="hero__title">
        <span class="hero__line" data-edit="site:heroHeading">
          {
            headingWords.map((word, index) => (
              <>
                {index > 0 && ' '}
                <span class="word" style={`--i:${index}`}>
                  {word}
                </span>
              </>
            ))
          }
        </span>
        {' '}
        <span class="hero__line hero__line--accent" data-edit="site:heroAccent">
          {
            accentWords.map((word, index) => (
              <>
                {index > 0 && ' '}
                <span class="word" style={`--i:${index + headingWords.length}`}>
                  {word}
                </span>
              </>
            ))
          }
        </span>
      </h1>
      {settings.tagline && <p class="hero__tagline" data-edit="site:tagline">{settings.tagline}</p>}
      <div class="hero__actions">
        <a class="button button--accent button--lg" href={shopUrl()}>
          <Copy name="home.shopButton" />
          <Icon name="arrow-right" />
        </a>
        {
          dm && (
            <a class="button button--ghost button--lg" href={dm.href} target={dm.external ? '_blank' : undefined} rel={dm.external ? 'noopener' : undefined}>
              <Icon name={dm.key === 'instagram' ? 'instagram' : 'arrow-up-right'} />
              <Copy name="common.dmButton" />
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    justDropped.length > 0 && (
      <section class="section" aria-labelledby="dropped-title">
        <div class="container">
          <div class="section__head" data-reveal>
            <div>
              <p class="eyebrow">
                <Icon name="spark" size={14} />
                <Copy name="home.droppedEyebrow" />
              </p>
              <h2 class="section__title" id="dropped-title">
                <Copy name="home.droppedTitle" accent />
              </h2>
            </div>
            <a class="section__link" href={shopUrl()}>
              <Copy name="home.droppedLink" />
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        </div>
        <ProductRail products={justDropped} label="Just dropped" />
      </section>
    )
  }

  {
    summaries.length > 0 && (
      <section class="section container" id="categories" aria-labelledby="categories-title">
        <div class="section__head" data-reveal>
          <div>
            <p class="eyebrow">
              <Icon name="spark" size={14} />
              <Copy name="home.categoriesEyebrow" />
            </p>
            <h2 class="section__title" id="categories-title">
              <Copy name="home.categoriesTitle" accent />
            </h2>
          </div>
        </div>
        <CategoryTiles summaries={summaries} />
      </section>
    )
  }

  {
    more.length > 0 && (
      <section class="section container" aria-labelledby="more-title">
        <div class="section__head" data-reveal>
          <div>
            <p class="eyebrow">
              <Icon name="spark" size={14} />
              <Copy name="home.moreEyebrow" />
            </p>
            <h2 class="section__title" id="more-title">
              <Copy name="home.moreTitle" accent />
            </h2>
          </div>
          <a class="section__link" href={shopUrl()}>
            <Copy name="home.moreLink" />
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
        <div class="product-grid">
          {more.map((product, index) => (
            <ProductCard product={product} index={index} />
          ))}
        </div>
      </section>
    )
  }

  {
    products.length > 0 && (
      <div class="section__footer container" data-reveal>
        <a class="button button--ghost button--lg" href={shopUrl()}>
          <Copy name="home.allButton" />
          <Icon name="arrow-right" />
        </a>
      </div>
    )
  }

  {
    products.length === 0 && (
      <section class="section container">
        <div class="empty">
          <p>No pieces yet.</p>
          <p>
            Add your first one in the <a href={url('/admin/')}>store admin</a>.
          </p>
        </div>
      </section>
    )
  }

  <section class="section container" id="how-it-works" aria-labelledby="how-title">
    <div class="section__head" data-reveal>
      <div>
        <p class="eyebrow">
          <Icon name="spark" size={14} />
          <Copy name="home.stepsEyebrow" />
        </p>
        <h2 class="section__title" id="how-title">
          <Copy name="home.stepsTitle" accent />
        </h2>
      </div>
    </div>
    <ol class="steps">
      <li class="step" data-reveal style="--i:0">
        <span class="step__num gradient-text">01</span>
        <h3><Copy name="home.step1Title" /></h3>
        <p><Copy name="home.step1Text" /></p>
      </li>
      <li class="step" data-reveal style="--i:1">
        <span class="step__num gradient-text">02</span>
        <h3><Copy name="home.step2Title" /></h3>
        <p><Copy name="home.step2Text" /></p>
      </li>
      <li class="step" data-reveal style="--i:2">
        <span class="step__num gradient-text">03</span>
        <h3><Copy name="home.step3Title" /></h3>
        <p><Copy name="home.step3Text" /></p>
      </li>
    </ol>
  </section>
</BaseLayout>

<script>
  // A soft light follows the pointer across the headline section (computers only).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    hero.addEventListener('pointermove', (event) => {
      const box = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${event.clientX - box.left}px`);
      hero.style.setProperty('--my', `${event.clientY - box.top}px`);
    });
  }
</script>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import ProductCard from '../components/ProductCard.astro';
import { getCategorySummaries, getListedProducts } from '../lib/catalog';
import { formatPrice, pluralise } from '../lib/format';
import { productPhoto, sharePreview } from '../lib/images';
import { settings } from '../lib/site';
import { productUrl, shopUrl, url } from '../lib/url';

const products = await getListedProducts();
const inStock = products.filter((product) => product.data.status !== 'sold');
const featured = inStock.filter((product) => product.data.featured).slice(0, 8);
const featuredIds = new Set(featured.map((product) => product.id));
const newest = inStock.filter((product) => !featuredIds.has(product.id)).slice(0, 12);
const summaries = (await getCategorySummaries()).filter((summary) => summary.count > 0);

const previewPhoto = (featured[0] ?? newest[0])?.data.images[0];
const preview = previewPhoto ? await sharePreview(previewPhoto) : undefined;
const spotlight = featured[0] ?? newest[0];
const spotlightPhoto = previewPhoto ? await productPhoto(previewPhoto) : undefined;
---

<BaseLayout image={preview}>
  <div class="container hero-wrap"><section class="hero">
    <div class="hero__orbit" aria-hidden="true"><span></span></div>
    <div class="hero__copy">
      <p class="eyebrow"><span class="live-dot" aria-hidden="true"></span> A universe of good finds</p>
      <h1 class="hero__title">{settings.heroHeading}<br /><span>{settings.heroAccent}</span></h1>
      {settings.tagline && <p class="hero__tagline">{settings.tagline}</p>}
        <div class="hero__actions">
          <a class="button" href={shopUrl()}>Shop the collection <span aria-hidden="true">↗</span></a>
          {summaries.length > 0 && <a class="text-link" href="#categories">Find your category <span aria-hidden="true">↓</span></a>}
        </div>
        <p class="hero__note">Good taste. Great finds. Just a message away.</p>
    </div>
    {spotlight && spotlightPhoto && (
      <a class="hero__spotlight" href={productUrl(spotlight.id)} aria-label={`Take a closer look: ${spotlight.data.title}`}>
        <div class="hero__spotlight-top"><span>Selected for you</span><span aria-hidden="true">↗</span></div>
        <div class="hero__image"><img src={spotlightPhoto.src} srcset={spotlightPhoto.srcset} sizes="(min-width: 900px) 420px, 85vw" width={spotlightPhoto.width} height={spotlightPhoto.height} alt={spotlight.data.title} fetchpriority="high" /></div>
        <div class="hero__caption"><div><span class="eyebrow">The spotlight</span><h2>{spotlight.data.title}</h2><span>{formatPrice(spotlight.data.price) ?? 'Ask for price'}</span></div><span class="circle-arrow" aria-hidden="true">↗</span></div>
      </a>
    )}
  </section></div>
  <div class="container"><div class="browse-strip"><span><span class="live-dot" aria-hidden="true"></span>{pluralise(inStock.length, 'find')} to explore</span><span>Pick your favourites. Message me for the details.</span><a href={shopUrl()}>Have a look <span aria-hidden="true">↗</span></a></div></div>

  {
    summaries.length > 0 && (
      <section class="section container" id="categories">
        <div class="section__head">
          <div><p class="eyebrow">Find your thing</p><h2 class="section__title">Shop by category</h2></div>
          <a class="section__link" href={shopUrl()}>View all <span aria-hidden="true">↗</span></a>
        </div>
        <CategoryTiles summaries={summaries} />
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="section container">
        <div class="section__head">
          <div><p class="eyebrow">Worth a closer look</p><h2 class="section__title">In the spotlight</h2></div>
          <span class="section__aside">A few favourites from the collection</span>
        </div>
        <div class="product-grid">
          {featured.map((product, index) => (
            <ProductCard product={product} eager={index < 2} />
          ))}
        </div>
      </section>
    )
  }

  {
    newest.length > 0 && (
      <section class="section container">
        <div class="section__head">
          <div><p class="eyebrow">Fresh in the rotation</p><h2 class="section__title">Just added</h2></div>
          <a class="section__link" href={shopUrl()}>See everything <span aria-hidden="true">↗</span></a>
        </div>
        <div class="product-grid">
          {newest.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
        <div class="section__footer">
          <a class="button button--ghost" href={shopUrl()}>Shop all</a>
        </div>
      </section>
    )
  }

  {
    products.length === 0 && (
      <section class="section container">
        <div class="empty">
          <p>No products yet.</p>
          <p>
            Add your first one on the <a href={url('/admin/')}>admin page</a>.
          </p>
        </div>
      </section>
    )
  }
  <section class="container"><div class="how-it-works"><div><p class="eyebrow">Keep it simple</p><h2>See it. Like it.<br />Message me.</h2></div><ol><li><span>01</span><div><h3>Have a browse</h3><p>Search the collection or jump into your favourite category.</p></div></li><li><span>02</span><div><h3>Get a closer look</h3><p>Check the photos, sizes, price and availability.</p></div></li><li><span>03</span><div><h3>Let’s talk</h3><p>Message me about the item, or share its link with a friend.</p></div></li></ol></div></section>
</BaseLayout>

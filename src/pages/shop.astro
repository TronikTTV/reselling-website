---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProductBrowser from '../components/ProductBrowser.astro';
import { getCategorySummaries, getListedProducts } from '../lib/catalog';
import { pluralise } from '../lib/format';
import { sharePreview } from '../lib/images';
import { settings } from '../lib/site';

const products = await getListedProducts();
const summaries = await getCategorySummaries();
const previewPhoto = products.find((product) => product.data.status !== 'sold')?.data.images[0];
const preview = previewPhoto ? await sharePreview(previewPhoto) : undefined;
---

<BaseLayout
  title="Shop all"
  description={`Browse all ${pluralise(products.length, 'piece')} from ${settings.siteName}.`}
  image={preview}
  currentCategory="all"
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">
        <Icon name="spark" size={14} />
        {pluralise(products.length, 'piece')}
      </p>
      <h1 class="page-head__title">Shop <em>everything</em></h1>
      <p class="page-head__desc">Every piece, hand-picked and authentic. Search, filter and find your next favourite.</p>
    </header>
    <ProductBrowser products={products} categories={summaries} />
  </div>
</BaseLayout>

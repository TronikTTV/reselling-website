---
// The old owner dashboard's address. Everything it showed (and much more) is now in the Studio at
// /admin/, so this just forwards there for old bookmarks.
import { url } from '../lib/url';

const target = url('/admin/');
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Store admin</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #050507; color: #a3a3ae; font: 15px system-ui, sans-serif; }
      a { color: #cfd8ff; }
    </style>
  </head>
  <body>
    <p>The dashboard has moved to the <a href={target}>store admin</a>.</p>
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </body>
</html>

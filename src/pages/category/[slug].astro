---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductBrowser from '../../components/ProductBrowser.astro';
import { categoryOf, getCategorySummaries, getListedProducts, type CategorySummary } from '../../lib/catalog';
import { pluralise } from '../../lib/format';
import { sharePreview } from '../../lib/images';

export async function getStaticPaths() {
  const summaries = await getCategorySummaries();
  return summaries.map((summary) => ({ params: { slug: summary.category.slug }, props: { summary } }));
}

interface Props {
  summary: CategorySummary;
}

const { category, cover } = Astro.props.summary;
const products = (await getListedProducts()).filter((product) => categoryOf(product).slug === category.slug);
const previewPhoto = cover?.data.images[0];
const preview = previewPhoto ? await sharePreview(previewPhoto) : undefined;

// The last word of the name gets the italic accent: "Hats & Caps" → "Hats & *Caps*".
const words = category.name.split(/\s+/);
const lead = words.slice(0, -1).join(' ');
const accent = words[words.length - 1];
---

<BaseLayout
  title={category.name}
  description={category.description || `${pluralise(products.length, 'piece')} in ${category.name}.`}
  image={preview}
  currentCategory={category.slug}
>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">
        <Icon name="spark" size={14} />
        {pluralise(products.length, 'piece')}
      </p>
      <h1 class="page-head__title">
        {lead && `${lead} `}<em>{accent}</em>
      </h1>
      <p class="page-head__desc">{category.description || `Hand-picked ${category.name.toLowerCase()}. Tap any piece for photos, sizes and price.`}</p>
    </header>
    <ProductBrowser products={products} />
  </div>
</BaseLayout>

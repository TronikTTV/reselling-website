---
import { contactLinks } from '../lib/contact';
import { settings } from '../lib/site';
import { shopUrl, url } from '../lib/url';

const links = contactLinks();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{settings.siteName}</p>
      {settings.tagline && <p>{settings.tagline}</p>}
      <p>© {year} {settings.siteName}</p>
    </div>
    {
      links.length > 0 && (
        <nav class="footer-links" aria-label="Contact">
          {links.map((link) => (
            <a class="chip" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
    <nav class="footer-links" aria-label="Store"><a href={shopUrl()}>The collection ↗</a><a href={url('/manage/')}>Owner tools</a></nav>
  </div>
</footer>

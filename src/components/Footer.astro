---
import Copy from './Copy.astro';
import Icon from './Icon.astro';
import Words from './Words.astro';
import { getCategorySummaries } from '../lib/catalog';
import { contactLinks, instagramHandle, primaryContact } from '../lib/contact';
import { settings } from '../lib/site';
import { categoryUrl, shopUrl, url } from '../lib/url';

const dm = primaryContact();
const handle = instagramHandle();
const profiles = contactLinks();
const topCategories = (await getCategorySummaries()).filter((summary) => summary.count > 0).slice(0, 5);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    {
      dm && (
        <section class="footer-cta" data-reveal aria-labelledby="footer-cta-title">
          <p class="eyebrow">
            <Icon name="spark" size={14} />
            <Copy name="footer.eyebrow" />
          </p>
          <h2 class="footer-cta__title" id="footer-cta-title">
            <Copy name="footer.title" accent />
          </h2>
          <p><Copy name="footer.text" /></p>
          <a class="button button--accent button--lg" href={dm.href} target={dm.external ? '_blank' : undefined} rel={dm.external ? 'noopener' : undefined}>
            <Icon name={dm.key === 'instagram' ? 'instagram' : 'arrow-up-right'} />
            {handle ?? dm.label}
          </a>
        </section>
      )
    }

    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a class="brand" href={url('/')}>
          <span class="brand__mark" aria-hidden="true"><Icon name="spark" size={18} /></span>
          <span class="brand__name" data-edit="site:siteName">{settings.siteName}</span>
        </a>
        {settings.tagline && <p data-edit="site:tagline"><Words text={settings.tagline} /></p>}
      </div>
      <nav class="footer-col" aria-label="Shop">
        <p class="footer-col__title"><Copy name="footer.shopHeading" /></p>
        <a href={shopUrl()}><Copy name="footer.everything" /></a>
        {topCategories.map(({ category }) => <a href={categoryUrl(category.slug)}>{category.name}</a>)}
      </nav>
      <nav class="footer-col" aria-label="Contact">
        <p class="footer-col__title"><Copy name="footer.contactHeading" /></p>
        {
          profiles.map((link) => (
            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
              {link.label}
            </a>
          ))
        }
        <a href={url('/#how-it-works')}><Copy name="nav.howItWorks" /></a>
      </nav>
    </div>

    <p class="footer-wordmark" aria-hidden="true" data-edit="site:siteName">{settings.siteName}</p>

    <div class="site-footer__legal">
      <span>{`© ${year} ${settings.siteName}`}</span>
      <a href={url('/admin/')}>Store admin</a>
    </div>
  </div>
</footer>

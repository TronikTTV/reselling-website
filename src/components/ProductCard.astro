---
import Icon from './Icon.astro';
import { categoryOf, type Product } from '../lib/catalog';
import { formatPrice, STATUS_LABELS } from '../lib/format';
import { productPhoto } from '../lib/images';
import { normalise } from '../lib/search';
import { productUrl } from '../lib/url';

interface Props {
  product: Product;
  /** Load the photo straight away (for cards at the top of the page). */
  eager?: boolean;
  /** Start hidden (ProductBrowser reveals cards in batches). */
  hidden?: boolean;
  /** Position in its row, used to stagger the slide-in animation. */
  index?: number;
}

const { product, eager = false, hidden = false, index = 0 } = Astro.props;
const { title, brand, price, retailPrice, status, size, condition, tags, date, images, styleCode, colourway, authenticity } =
  product.data;
const category = categoryOf(product);
const photo = images[0] ? await productPhoto(images[0]) : undefined;
const priceText = formatPrice(price);
const showRetail = retailPrice !== undefined && price !== undefined && retailPrice > price;
const verified = status === 'available' && (authenticity === 'stockx' || authenticity === 'goat');
// The data-* attributes on <article> are read by ProductBrowser's filter script, and data-vt-link /
// data-vt-photo by the page-transition script in BaseLayout. Keep them whatever the card looks like.
---

<article
  class:list={['card', `card--${status}`]}
  data-product
  data-search={normalise([title, brand, category.name, size, condition, styleCode, colourway, ...tags].filter(Boolean).join(' '))}
  data-category={category.slug}
  data-brand={brand ? normalise(brand) : ''}
  data-price={price ?? ''}
  data-status={status}
  data-date={date?.getTime() ?? 0}
  data-title={normalise(title)}
  hidden={hidden}
  data-reveal
  style={`--i:${index % 4}`}
>
  <a class="card__link" href={productUrl(product.id)} data-vt-link>
    <div class="card__media">
      {!photo && <span class="card__placeholder">Photos coming soon</span>}
      {
        photo && (
          <img
            class="card__img"
            src={photo.src}
            srcset={photo.srcset}
            sizes="(min-width: 1320px) 300px, (min-width: 1100px) 23vw, (min-width: 700px) 31vw, 48vw"
            width={photo.width}
            height={photo.height}
            alt={title}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            data-vt-photo
            data-fade
          />
        )
      }
      <div class="card__badges">
        {status !== 'available' && <span class:list={['badge', `badge--${status}`]}>{STATUS_LABELS[status]}</span>}
        {
          verified && (
            <span class="badge">
              <Icon name="check" size={12} />
              Verified
            </span>
          )
        }
      </div>
      <span class="card__cta" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
    </div>
    <div class="card__body">
      <p class="card__brand">{brand || category.name}</p>
      <h3 class="card__title">{title}</h3>
      <div class="card__foot">
        <p class="card__price">
          {priceText ? <span>{priceText}</span> : <span class="card__ask">Ask for price</span>}
          {showRetail && <s class="rrp">{formatPrice(retailPrice)}</s>}
        </p>
        {size && <span class="card__size">{size}</span>}
      </div>
    </div>
  </a>
</article>

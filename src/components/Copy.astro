---
// A piece of the site's wording from Site text (src/data/content.json). The data-edit hook lets the
// admin Studio's live editor find it, so keep it whatever the markup around it looks like.
// With `accent`, words wrapped in *stars* (or else the last word) are shown in italics.
import { accentParts, copy, type CopyKey } from '../lib/copy';

interface Props {
  name: CopyKey;
  accent?: boolean;
}

const { name, accent = false } = Astro.props;
const text = copy(name);
const parts = accent ? accentParts(text) : [{ text, accent: false }];
---

<span data-edit={`copy:${name}`}>{parts.map((part) => (part.accent ? <em>{part.text}</em> : part.text))}</span>

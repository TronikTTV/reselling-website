---
import Icon from './Icon.astro';
import { getCategorySummaries } from '../lib/catalog';
import { primaryContact } from '../lib/contact';
import { settings } from '../lib/site';
import { categoryUrl, shopUrl, url } from '../lib/url';

interface Props {
  currentCategory?: string;
}

const { currentCategory } = Astro.props;
// Only categories that have something in them appear in the menu.
const summaries = (await getCategorySummaries()).filter((summary) => summary.count > 0);
const dm = primaryContact();
---

{
  settings.announcement && (
    <div class="announcement">
      <p>{settings.announcement}</p>
    </div>
  )
}
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="brand" href={url('/')}>
      <span class="brand__mark" aria-hidden="true"><Icon name="spark" size={18} /></span>
      <span class="brand__name">{settings.siteName}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href={shopUrl()} aria-current={currentCategory === 'all' ? 'page' : undefined}>Shop all</a>
      <a href={url('/#categories')}>Categories</a>
      <a href={url('/#how-it-works')}>How it works</a>
    </nav>
    <div class="site-header__actions">
      <a class="icon-button" href={shopUrl()} data-open-search aria-label="Search">
        <Icon name="search" />
      </a>
      {
        dm && (
          <a class="button button--accent button--sm header-dm" href={dm.href} target={dm.external ? '_blank' : undefined} rel={dm.external ? 'noopener' : undefined}>
            <Icon name={dm.key === 'instagram' ? 'instagram' : 'arrow-up-right'} size={16} />
            <span>DM to cop</span>
          </a>
        )
      }
    </div>
  </div>
  {
    summaries.length > 0 && (
      <nav class="category-nav" aria-label="Categories">
        <div class="container category-nav__track">
          <a class="chip" href={shopUrl()} aria-current={currentCategory === 'all' ? 'page' : undefined}>
            All
          </a>
          {summaries.map(({ category, count }) => (
            <a class="chip" href={categoryUrl(category.slug)} aria-current={currentCategory === category.slug ? 'page' : undefined}>
              {category.name}
              <span class="chip__count">{count}</span>
            </a>
          ))}
        </div>
      </nav>
    )
  }
</header>

<dialog class="search-sheet" data-search-sheet aria-label="Search the collection">
  <form class="search-sheet__form" action={shopUrl()} method="get" role="search">
    <Icon name="search" size={22} />
    <input type="search" name="q" placeholder="Search brands, styles, sizes…" autocomplete="off" enterkeyhint="search" aria-label="Search products" />
    <button type="button" class="icon-button" data-close-search aria-label="Close search">
      <Icon name="close" />
    </button>
  </form>
  {
    summaries.length > 0 && (
      <div class="search-sheet__quick">
        <p class="eyebrow">Jump to</p>
        <div class="search-sheet__chips">
          {summaries.map(({ category }) => (
            <a class="chip" href={categoryUrl(category.slug)}>
              {category.name}
            </a>
          ))}
        </div>
      </div>
    )
  }
</dialog>
